[control_nodes]
%{ for name, vm in vms ~}
%{ if vm.role == "control" ~}
${name} ansible_host=${split("/", vm.ip4)[0]}
%{ endif ~}
%{ endfor ~}

[worker_nodes]
%{ for name, vm in vms ~}
%{ if vm.role == "worker" ~}
${name} ansible_host=${split("/", vm.ip4)[0]}
%{ endif ~}
%{ endfor ~}

[all:vars]
ansible_user=${jsonencode(user)}
ansible_ssh_private_key_file=${jsonencode(private_key)}
