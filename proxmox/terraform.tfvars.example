# Proxmox Credentials
# Leave PM_USER, PM_PASSWORD, and pve_ssh_password unset here so Terraform
# prompts for them interactively during `terraform plan` / `terraform apply`.
# PM_USER          = "root@pam"
# PM_PASSWORD      = "your-api-password-or-token"
# pve_ssh_password = "your-root-ssh-password"

# Proxmox Node & SSH Info
pve_api_url         = "https://192.168.1.100:8006/"
pve_ssh_user        = "root"
pve_ssh_private_key = "~/.ssh/id_rsa"

# Image and Template details
image_url     = "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
template_id   = 9000
template_name = "ubuntu-24.04-cloud"
bridge        = "vmbr0"

# Datastores
iso_ds       = "local"       # Must allow Snippets (for cloud-init)
vm_ds        = "local-lvm"   # Must allow Disk images
content_type = "iso"

# Proxmox Target Nodes
nodes = {
  "pve1" = {
    vm_id = 9000
  }
}

# Kubernetes Cluster VM Definitions
vms = {
  "k8s-control-1" = {
    n_name = "pve1"
    id     = 100
    cpu    = 2
    memory = 4096
    ip4 = "192.168.1.160/24" # has to be static since tf generates inventory based on this
    gw4  = "192.168.1.1"
    ip6  = "fd00:10:244::110/64"
    gw6  = "fd00:10:244::1"
  },
  "k8s-worker-1" = {
    n_name = "pve1"
    id     = 200
    cpu    = 4
    memory = 8192
    ip4    = "192.168.1.161/24"
    gw4  = "192.168.1.1"
    ip6  = "fd00:10:244::200/64"
    gw6  = "fd00:10:244::1"
  }
}
